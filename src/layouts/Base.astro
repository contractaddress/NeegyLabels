---
import BgStream from '../components/BgStream.astro';
import { getAllChains, getAllTypes } from '../lib/db.ts';
import { usingFallbackSecret } from '../lib/secret.ts';

export interface Props {
  title: string;
  description?: string;
  requireAuth?: boolean;
}

const { title, description, requireAuth = true } = Astro.props;
const isFallbackSecret = usingFallbackSecret();
const registryStyles = [
  ...getAllChains().map(({ name, color }) =>
    `.badge[data-chain="${name}"] { border-color: ${color}; color: ${color}; }\n.chain-chip[data-chain="${name}"] { color: ${color}; }`,
  ),
  ...getAllTypes().map(({ name, color }) =>
    `.badge[data-type="${name}"] { border-color: ${color}; color: ${color}; }\n.type-chip[data-type="${name}"] { color: ${color}; }`,
  ),
].join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — NeegyLabels</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style is:inline set:html={registryStyles}></style>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        function storedSet(key) {
          try {
            const value = JSON.parse(localStorage.getItem(key) || '[]');
            return new Set(Array.isArray(value) ? value : []);
          } catch {
            return new Set();
          }
        }

        function setupArchive(kind) {
          const storageKey = `neegy_hidden_${kind}s`;
          const hidden = storedSet(storageKey);
          const itemSelector = `.${kind}-chip[data-${kind}]`;
          let showArchived = false;

          function render() {
            document.querySelectorAll(itemSelector).forEach(item => {
              const name = item.dataset[kind];
              const archived = name && hidden.has(name);
              const isManagerCard = Boolean(item.closest(`[data-archive-manager="${kind}"]`));
              item.classList.toggle('is-archived', Boolean(archived));
              item.style.display = archived && !(isManagerCard && showArchived) ? 'none' : '';

              const archiveBtn = item.querySelector(`.${kind}-archive-btn`);
              if (archiveBtn) archiveBtn.textContent = archived ? 'restore' : 'archive';
            });

            document.querySelectorAll(`#${kind}-list option`).forEach(option => {
              const archived = hidden.has(option.value);
              option.hidden = archived;
              option.disabled = archived;
            });

            const showBtn = document.querySelector(`[data-show-archived="${kind}"]`);
            if (showBtn) {
              showBtn.textContent = showArchived ? 'hide archived' : `show archived (${hidden.size})`;
              showBtn.disabled = hidden.size === 0;
            }
          }

          render();

          document.querySelectorAll(`.${kind}-archive-btn`).forEach(btn => {
            btn.addEventListener('click', () => {
              const name = btn.closest(itemSelector)?.dataset[kind];
              if (!name) return;
              if (hidden.has(name)) hidden.delete(name);
              else hidden.add(name);
              localStorage.setItem(storageKey, JSON.stringify([...hidden]));
              render();
            });
          });

          document.querySelector(`[data-show-archived="${kind}"]`)?.addEventListener('click', () => {
            showArchived = !showArchived;
            render();
          });
        }

        setupArchive('chain');
        setupArchive('type');

        document.addEventListener('click', (e) => {
          const el = e.target.closest ? e.target.closest('.copy-addr') : null;
          if (!el) return;
          const addr = el.dataset.addr;
          if (!addr) return;

          const fallbackCopy = (text) => {
            const i = document.createElement('textarea');
            i.value = text;
            i.style.position = 'fixed';
            i.style.left = '-9999px';
            document.body.appendChild(i);
            i.select();
            document.execCommand('copy');
            i.remove();
          };

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(addr).catch(() => fallbackCopy(addr));
          } else {
            fallbackCopy(addr);
          }

          const t = document.createElement('span');
          t.textContent = 'copied!';
          t.style.cssText = 'position:fixed;background:var(--bg-elevated);color:var(--accent);border:1px solid var(--accent-dim);padding:0.2rem 0.5rem;font-size:0.7rem;pointer-events:none;z-index:9999;white-space:nowrap;opacity:0;transition:opacity 0.15s;';
          document.body.appendChild(t);
          const r = el.getBoundingClientRect();
          t.style.left = (r.left + r.width / 2) + 'px';
          t.style.top = (r.top - 32) + 'px';
          t.style.transform = 'translateX(-50%)';
          requestAnimationFrame(() => { t.style.opacity = 1; });
          setTimeout(() => { t.style.opacity = 0; setTimeout(() => t.remove(), 200); }, 700);
        });

        const streamKey = 'neegy_stream_enabled';
        const toggleBtn = document.getElementById('toggle-stream');
        const streamEl = document.querySelector('.bg-stream');
        const streamEnabled = localStorage.getItem(streamKey) !== 'off';

        function applyStream(on) {
          if (streamEl) streamEl.style.display = on ? '' : 'none';
          if (toggleBtn) toggleBtn.textContent = on ? '◉' : '○';
        }
        applyStream(streamEnabled);

        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            const isOn = streamEl?.style.display !== 'none';
            localStorage.setItem(streamKey, isOn ? 'off' : 'on');
            applyStream(!isOn);
          });
        }

        document.querySelectorAll('table.sortable').forEach((table) => {
          const headers = Array.from(table.querySelectorAll('th[data-sort]'));
          const isNum = (v) => v !== '' && /^-?\d+(\.\d+)?$/.test(v);
          headers.forEach((th) => {
            th.addEventListener('click', () => {
              const tbody = table.querySelector('tbody');
              if (!tbody) return;
              const key = th.dataset.sort;
              const dir = th.dataset.dir === 'asc' ? 'desc' : 'asc';
              headers.forEach((o) => { if (o !== th) delete o.dataset.dir; });
              th.dataset.dir = dir;

              const rows = Array.from(tbody.querySelectorAll('tr')).filter((r) => key in (r.dataset || {}));
              rows.sort((a, b) => {
                const av = a.dataset[key];
                const bv = b.dataset[key];
                if (av === undefined && bv === undefined) return 0;
                if (av === undefined) return 1;
                if (bv === undefined) return -1;
                let cmp;
                if (isNum(av) && isNum(bv)) cmp = parseFloat(av) - parseFloat(bv);
                else cmp = String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: 'base' });
                return dir === 'asc' ? cmp : -cmp;
              });
              rows.forEach((r) => tbody.appendChild(r));
            });
          });
        });
      });
    </script>
  </head>
  <body>
    <BgStream />
    {isFallbackSecret && (
      <div style="position:fixed;bottom:0;left:0;right:0;z-index:50;background:#141414;color:var(--text-muted);border-top:1px solid var(--border);padding:0.5rem 1rem;font-size:0.8rem;text-align:center;">
        API_KEY is not set — using an auto-generated session secret. Set <code>API_KEY</code> in <code>.env</code> to use it directly as a Bearer token and keep sessions across redeploys.
      </div>
    )}
    <header>
      <a href="/" class="logo">
        <span class="prompt">~</span><span class="slash">/</span>neegy<span class="caret">_</span>
      </a>
      <nav>
        <a href="/add">/add</a>
        <a href="/manage">/manage</a>
        <a href="/docs">/docs</a>
        <a href="/admin">/admin</a>
        <button id="toggle-stream" title="toggle background" style="background:none;border:1px solid var(--border);color:var(--text-muted);padding:0.15rem 0.45rem;font-size:0.7rem;cursor:pointer;margin-left:1.5rem;">◉</button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Mononoki Nerd Font';
    src: local('Mononoki Nerd Font Mono'), local('mononoki Nerd Font Mono');
    font-weight: 400;
    font-style: normal;
  }

  :root {
    --bg: #0a0a0a;
    --bg-elevated: #111111;
    --bg-hover: #1a1a1a;
    --border: #252525;
    --border-active: #3a3a3a;
    --text: #b8b8b8;
    --text-muted: #5c5c5c;
    --text-bright: #e0e0e0;
    --accent: #50fa7b;
    --accent-dim: #28753e;
    --accent2: #ff79c6;
    --accent3: #8be9fd;
    --warn: #f1fa8c;
    --danger: #ff5555;
    --conf-low: #ff5555;
    --conf-mid: #f59e0b;
    --conf-high: #50fa7b;
    --font: 'Mononoki Nerd Font', 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    --font-size: 15px;
    --line-height: 1.6;
    --radius: 0px;
    --gap: 1rem;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: var(--font-size);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: var(--line-height);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #0a0a0a;
    position: relative;
  }

  .bg-stream {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 0;
    pointer-events: none;
    font-family: var(--font);
    font-size: 0.9rem;
    line-height: 1.2;
    color: #2a2d36;
    opacity: 0.22;
    white-space: pre;
    text-align: center;
    padding-top: 60px;
    animation: scroll-up 546s linear infinite;
  }

  @keyframes scroll-up {
    0%   { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 2rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a,
  .logo {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s;
    letter-spacing: 0.02em;
  }

  nav a:hover,
  nav a[aria-current="page"],
  .logo:hover {
    color: var(--accent);
  }

  .logo {
    color: var(--text-bright);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .logo .prompt {
    color: var(--accent);
  }

  .logo .slash {
    color: var(--accent2);
  }

  .logo .caret {
    color: var(--accent);
    animation: blink 1s step-end infinite;
    font-weight: 400;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  main {
    flex: 1;
    padding: 2rem;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: 1.5rem;
    color: var(--text-bright);
    font-weight: 700;
    letter-spacing: 0.03em;
    position: relative;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1::before {
    content: '# ';
    color: var(--accent-dim);
  }

  h2 {
    font-size: 1.15rem;
    color: var(--text-bright);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  h2::before {
    content: '> ';
    color: var(--accent-dim);
  }

  a {
    color: var(--accent3);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    background: rgba(14,14,14,0.45);
    backdrop-filter: blur(3px);
  }

  thead th {
    text-align: left;
    padding: 0.7rem 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--border-active);
    background: var(--bg-elevated);
  }

  table.sortable th[data-sort] {
    cursor: pointer;
    user-select: none;
  }

  table.sortable th[data-sort]:hover {
    color: var(--text-bright);
  }

  table.sortable th[data-sort][data-dir="asc"]::after {
    content: ' ↑';
    color: var(--accent);
  }

  table.sortable th[data-sort][data-dir="desc"]::after {
    content: ' ↓';
    color: var(--accent);
  }

  tbody td {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  tbody tr:hover {
    background: var(--bg-hover);
  }

  /* Forms */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  input,
  select,
  textarea {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-family: var(--font);
    font-size: 0.92rem;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--accent-dim);
    box-shadow: 0 0 0 1px var(--accent-dim);
  }

  input::placeholder {
    color: var(--text-muted);
  }

  select {
    cursor: pointer;
  }

  select option {
    background: var(--bg-elevated);
    color: var(--text);
  }

  button,
  .btn {
    background: var(--bg-elevated);
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    padding: 0.6rem 1.2rem;
    font-family: var(--font);
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  button:hover,
  .btn:hover {
    background: var(--accent-dim);
    color: var(--bg);
    border-color: var(--accent);
  }

  button.danger {
    border-color: var(--danger);
    color: var(--danger);
  }

  button.danger:hover {
    background: var(--danger);
    color: var(--bg);
  }

  /* Search */
  .search-bar {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .search-bar input {
    flex: 1;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border-color: var(--border-active);
  }

  .search-bar input:focus {
    border-color: var(--accent-dim);
  }

  .search-bar button {
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
  }

  /* Badge */
  .badge {
    display: inline-block;
    padding: 0.18rem 0.6rem;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  /* Address display */
  .address-mono {
    font-family: var(--font);
    color: var(--accent3);
    word-break: break-all;
  }

  .address-mono a {
    color: inherit;
  }

  .address-mono a:hover {
    color: var(--accent);
  }

  /* Monospace address clipping */
  .addr-prefix {
    color: var(--text);
  }

  .addr-suffix {
    color: var(--text-muted);
  }

  /* No results */
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  .empty-state p {
    margin-top: 0.5rem;
  }

  /* Flash messages */
  .flash {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .flash.success {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .flash.error {
    border-color: var(--danger);
    color: var(--danger);
  }

  /* Form */
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 560px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  /* Section card */
  .section {
    background: rgba(14,14,14,0.45);
    backdrop-filter: blur(3px);
    border: 1px solid #363636;
    padding: 1.2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.6rem;
  }

  .chain-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.8rem;
    border: 1px solid #363636;
    color: var(--accent3);
    text-decoration: none;
    font-size: 0.88rem;
    transition: all 0.15s;
  }

  .chain-chip:hover {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .chain-chip .count {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .mono {
    font-family: var(--font);
  }

  .text-muted {
    color: var(--text-muted);
  }

  .address-cell {
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gap-top {
    margin-top: var(--gap);
  }

  .inline-flex {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  ::selection {
    background: var(--accent-dim);
    color: var(--bg);
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--border-active);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  .hl-key  { color: #ff79c6; }
  .hl-str  { color: #f1fa8c; }
  .hl-num  { color: #bd93f9; }
  .hl-bool { color: #8be9fd; }
  .hl-brk  { color: #6272a4; }

  .doc-param { color: var(--accent3); font-weight: 600; }
  .doc-type  { color: var(--accent); }
  .doc-req-y { color: #f1fa8c; }
  .doc-req-n { color: #5c5c5c; }
  .doc-num   { color: #bd93f9; font-weight: 600; }

  @media (max-width: 700px) {
    header {
      padding: 1rem;
      gap: 1rem;
    }

    nav {
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.5rem 0.8rem;
    }

    nav a {
      font-size: 0.8rem;
    }

    #toggle-stream {
      margin-left: 0 !important;
    }

    main {
      padding: 1rem;
    }
  }
</style>
