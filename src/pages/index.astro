---
import Base from '../layouts/Base.astro';
import { getRecentLabels, getChainCounts, lookupByAddress, deleteLabel, getTypeCounts, getLabelCount, getDistinctChains } from '../lib/db.ts';
import { explorerUrl } from '../lib/explorers.ts';

const url = new URL(Astro.request.url);
const searchAddr = url.searchParams.get('address')?.trim() ?? null;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const delAddr = data.get('del_address')?.toString();
  const delChain = data.get('del_chain')?.toString();
  if (delAddr && delChain) {
    deleteLabel(delAddr, delChain);
  }
  return Astro.redirect(`/?address=${encodeURIComponent(delAddr ?? '')}`);
}

const searchResults = searchAddr ? lookupByAddress(searchAddr) : null;
const labels = getRecentLabels(20);
const chainCounts = getChainCounts();
const typeCounts = getTypeCounts();
const totalLabels = getLabelCount();
const totalChains = getDistinctChains().length;
const totalTypes = typeCounts.length;
---

<Base title="Home">
  <h1>root</h1>

  <div style="display:flex;gap:1.5rem;margin-bottom:1.5rem;">
    <div style="text-align:center;">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent3);">{totalLabels}</div>
      <div class="text-muted" style="font-size:0.75rem;">labels</div>
    </div>
    <div style="text-align:center;">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent2);">{totalChains}</div>
      <div class="text-muted" style="font-size:0.75rem;">chains</div>
    </div>
    <div style="text-align:center;">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent);">{totalTypes}</div>
      <div class="text-muted" style="font-size:0.75rem;">types</div>
    </div>
  </div>
  <p class="text-muted gap-top" style="margin-bottom:1.5rem;">
    On-chain label database for EVM addresses.
  </p>

  <form action="/" method="GET" class="search-bar" style="max-width:600px;">
    <input
      type="text"
      name="address"
      placeholder="0x..."
      value={searchAddr ?? ''}
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit">resolve</button>
  </form>

  <form action="/search" method="GET" class="search-bar" style="max-width:200px;">
    <input
      type="text"
      name="label"
        placeholder="label search..."
        autocomplete="off"
      style="font-size:0.88rem;padding:0.45rem 0.7rem;"
    />
    <button type="submit" style="font-size:0.88rem;padding:0.45rem 0.9rem;">find</button>
  </form>

  {searchResults !== null && (
    <>
      <div class="section-header">
        <h2><span class="address-mono">{searchAddr}</span></h2>
        <span class="text-muted">{searchResults.length} {searchResults.length === 1 ? 'label' : 'labels'}</span>
      </div>
      {searchResults.length === 0 ? (
        <div class="empty-state"><p>no labels found</p></div>
      ) : (
        <table class="sortable">
          <thead>
            <tr><th data-sort="chain">Chain</th><th data-sort="label">Label</th><th data-sort="type">Type</th><th data-sort="conf">Conf</th><th data-sort="source">Source</th><th data-sort="added">Added</th><th></th></tr>
          </thead>
          <tbody>
            {searchResults.map((l) => (
              <tr data-chain={l.chain} data-label={l.label} data-type={l.type} data-conf={l.confidence} data-source={l.source} data-added={l.added_at}>
                {(() => {
                  const url = explorerUrl(l.chain, l.address);
                  return (
                    <td>
                      {url ? (
                        <a href={url} target="_blank" rel="noopener" class="badge" data-chain={l.chain} style="text-decoration:none;">{l.chain}</a>
                      ) : (
                        <span class="badge" data-chain={l.chain}>{l.chain}</span>
                      )}
                    </td>
                  );
                })()}
                <td><strong>{l.label}</strong></td>
                <td><a href={`/type/${l.type}`} class="badge" data-type={l.type} style="text-decoration:none;">{l.type}</a></td>
                <td style={l.confidence != null ? `color:var(--conf-${l.confidence < 40 ? 'low' : l.confidence < 70 ? 'mid' : 'high'});font-weight:600` : ''}>{l.confidence != null ? l.confidence : '—'}</td>
                <td class="text-muted">{l.source}</td>
                <td class="text-muted">{l.added_at.slice(0, 10)}</td>
                <td>
                  <div style="display:flex;align-items:center;gap:0.4rem;">
                    <form method="POST" style="display:inline;max-width:none;" onsubmit="return confirm('Delete this label?')">
                      <input type="hidden" name="del_address" value={l.address} />
                      <input type="hidden" name="del_chain" value={l.chain} />
                      <button class="danger" style="padding:0.15rem 0.45rem;font-size:0.7rem;" title="delete">x</button>
                    </form>
                    <form method="GET" action="/add" style="display:inline;max-width:none;">
                      <input type="hidden" name="address" value={l.address} />
                      <input type="hidden" name="chain" value={l.chain} />
                      <button style="padding:0.15rem 0.45rem;font-size:0.7rem;border:1px solid var(--accent3);color:var(--accent3);" title="edit">e</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </>
  )}

  <section>
    <div class="section">
      <div class="section-header">
        <h2>chains</h2>
        <span class="text-muted">{chainCounts.length} total</span>
      </div>
      <div class="grid-2">
        {chainCounts.map(({ chain, count }) => (
          <a href={`/chain/${chain}`} class="chain-chip" data-chain={chain}>
            <span class="mono">
              {chain === '*' ? (
                <span class="badge" data-chain="*">*</span>
              ) : null}
              {' '}{chain}
            </span>
            <span class="count">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="section-header">
        <h2>types</h2>
        <span class="text-muted">{typeCounts.length} total</span>
      </div>
      <div class="grid-2">
        {typeCounts.map(({ type, count }) => (
          <a href={`/type/${type}`} class="chain-chip type-chip" data-type={type}>
            <span class="badge" data-type={type} style="border:none;font-size:0.82rem;">{type}</span>
            <span class="count">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>recent_labels</h2>
    </div>
    <table>
      <thead>
        <tr><th>Address</th><th>Chain</th><th>Label</th><th>Type</th><th>Conf</th><th>Added</th></tr>
      </thead>
      <tbody>
        {labels.length === 0 ? (
          <tr><td colspan="6" class="empty-state"><p>no labels in database</p></td></tr>
        ) : (
          labels.map((l) => (
            <tr>
              <td class="address-cell">
                <span class="address-mono">
                  <a href={`/?address=${l.address}`}>
                    <span class="addr-prefix">{l.address.slice(0, 6)}</span>...<span class="addr-suffix">{l.address.slice(-4)}</span>
                  </a>
                </span>
              </td>
              <td><span class="badge" data-chain={l.chain}>{l.chain}</span></td>
              <td>{l.label}</td>
              <td><a href={`/type/${l.type}`} class="badge" data-type={l.type} style="text-decoration:none;">{l.type}</a></td>
              <td style={l.confidence != null ? `color:var(--conf-${l.confidence < 40 ? 'low' : l.confidence < 70 ? 'mid' : 'high'});font-weight:600` : ''}>{l.confidence != null ? l.confidence : '—'}</td>
              <td class="text-muted">{l.added_at.slice(0, 10)}</td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </section>
</Base>

<style>
  .chain-chip {
    border-color: currentColor;
  }
</style>
