---
import Base from '../layouts/Base.astro';
import { createToken, revokeToken, listTokens } from '../lib/tokens.ts';
import { insertLabel } from '../lib/db.ts';
import Database from 'better-sqlite3';
import { unlink, writeFile } from 'node:fs/promises';
import { randomBytes } from 'node:crypto';

let result: { token?: string; id?: string } | null = null;
let error: string | null = null;
let revoked: string | null = null;
let imported = 0;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();

    if (action === 'generate') {
      const name = data.get('name')?.toString()?.trim();
      if (!name) {
        error = 'Token name is required';
      } else {
        result = createToken(name);
      }
    } else if (action === 'revoke') {
      const id = data.get('id')?.toString();
      if (id) {
        revokeToken(id);
        revoked = id;
      }
    } else if (action === 'import') {
      const file = data.get('dbfile') as File | null;
      if (!file || !file.name.endsWith('.db')) {
        error = 'Please upload a .db SQLite file';
      } else {
        const tmpPath = `/tmp/neegy_import_${randomBytes(4).toString('hex')}.db`;
        const buf = Buffer.from(await file.arrayBuffer());
        await writeFile(tmpPath, buf);
        const tmpDb = new Database(tmpPath);
        const rows = tmpDb.prepare('SELECT * FROM labels').all() as {
          address: string; chain: string; label: string; type: string; source: string;
        }[];
        for (const row of rows) {
          insertLabel(row);
          imported++;
        }
        tmpDb.close();
        await unlink(tmpPath);
      }
    }
  } catch (e) {
    error = String(e);
  }
}

const tokens = listTokens();
---

<Base title="Admin">
  <h1>admin_tokens</h1>

  {error && <div class="flash error">[err] {error}</div>}
  {revoked && <div class="flash success">[ok] token revoked</div>}
  {imported > 0 && <div class="flash success">[ok] imported {imported} labels</div>}

  {result ? (
    <div id="token-reveal" class="section" style="border-color: var(--accent-dim);">
      <div class="section-header">
        <h2 style="color: var(--accent);">token_generated</h2>
        <button onclick="document.getElementById('token-reveal').remove()" style="font-size:0.8rem;padding:0.3rem 0.7rem;">close</button>
      </div>
      <p class="text-muted" style="margin-bottom:0.5rem;">Copy now — this is the only time it will be shown.</p>
      <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;font-size:0.85rem;border:1px solid var(--border);"><code style="color:var(--accent);">{result.token}</code></pre>
      <p class="text-muted gap-top" style="font-size:0.78rem;">ID: {result.id} &nbsp;|&nbsp; token is not stored — only its SHA-256 hash is saved.</p>
    </div>
  ) : null}

  <div class="section">
    <div class="section-header">
      <h2>import_db</h2>
    </div>
    <p class="text-muted" style="margin-bottom:0.75rem;">Upload a <code>labels.db</code> file — labels will be merged (duplicates skipped).</p>
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="action" value="import" />
      <div class="search-bar">
        <input type="file" name="dbfile" accept=".db" required />
        <button type="submit">import()</button>
      </div>
    </form>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>generate_key</h2>
      <span class="text-muted">{tokens.length} active</span>
    </div>
    <form method="POST">
      <input type="hidden" name="action" value="generate" />
      <div class="search-bar">
        <input type="text" name="name" placeholder="token name (e.g. backend-prod)" required autocomplete="off" />
        <button type="submit">generate()</button>
      </div>
    </form>
  </div>

  <div>
    <h2>keys</h2>
    {tokens.length === 0 ? (
      <div class="empty-state"><p>no tokens created yet</p></div>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>ID</th>
            <th>Created</th>
            <th>Last Used</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {tokens.map((t) => (
            <tr>
              <td>{t.name}</td>
              <td class="mono text-muted">{t.id}</td>
              <td class="text-muted">{t.created_at.slice(0, 10)}</td>
              <td class="text-muted">{t.last_used_at ? t.last_used_at.slice(0, 16) : '—'}</td>
              <td>
                <form method="POST" style="display:inline;max-width:none;">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="id" value={t.id} />
                  <button class="danger" style="padding:0.2rem 0.6rem;font-size:0.75rem;">revoke</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</Base>
