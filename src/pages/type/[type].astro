---
import Base from '../../layouts/Base.astro';
import Address from '../../components/Address.astro';
import { lookupLabels } from '../../lib/db.ts';
import { explorerUrl } from '../../lib/explorers.ts';

const { type } = Astro.params;
const labels = lookupLabels({ type, limit: 10000 });
---

<Base title={`Type / ${type}`}>
  <h1>/type/{type}</h1>

  <div class="section-header">
    <span class="text-muted">{labels.length} {labels.length === 1 ? 'label' : 'labels'}</span>
  </div>

  {labels.length === 0 ? (
    <div class="empty-state"><p>no labels of type <strong>{type}</strong></p></div>
  ) : (
    <table class="sortable">
      <thead>
        <tr><th data-sort="addr">Address</th><th data-sort="chain">Chain</th><th data-sort="label">Label</th><th data-sort="conf">Conf</th><th data-sort="source">Source</th><th data-sort="added">Added</th><th></th></tr>
      </thead>
      <tbody>
        {labels.map((l) => (
          <tr data-addr={l.address} data-chain={l.chain} data-label={l.label} data-conf={l.confidence} data-source={l.source} data-added={l.added_at}>
            <td class="address-cell">
              <Address address={l.address} toast />
            </td>
            <td><span class="badge" data-chain={l.chain}>{l.chain}</span></td>
            <td>{l.label}</td>
            <td style={l.confidence != null ? `color:var(--conf-${l.confidence < 40 ? 'low' : l.confidence < 70 ? 'mid' : 'high'});font-weight:600` : ''}>{l.confidence != null ? l.confidence : '—'}</td>
            <td class="text-muted">{l.source}</td>
            <td class="text-muted">{l.added_at.slice(0, 10)}</td>
            <td>
              {explorerUrl(l.chain, l.address) && (
                <a href={explorerUrl(l.chain, l.address)!} target="_blank" rel="noopener" class="badge" data-chain={l.chain} style="text-decoration:none;font-size:0.7rem;padding:0.1rem 0.4rem;" title="explorer">↗</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Base>
