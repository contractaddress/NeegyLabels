---
import Base from '../../layouts/Base.astro';
import Address from '../../components/Address.astro';
import { lookupLabels, getDistinctChains, getChainCounts } from '../../lib/db.ts';
import { explorerUrl } from '../../lib/explorers.ts';

export function getStaticPaths() {
  const chains = getDistinctChains();
  return chains.map((chain) => ({ params: { chain } }));
}

export const prerender = false;

const { chain } = Astro.params;
const labels = lookupLabels({ chain, limit: 200 });
const chainCounts = getChainCounts();
const allChains = getDistinctChains();
---

<Base title={`Chain / ${chain}`}>
  <h1>/chain/{chain}</h1>

  <section>
    <div style="display:flex;justify-content:flex-end;margin-bottom:0.4rem;">
      <button type="button" class="edit-toggle-btn">✎ edit</button>
    </div>
    <div class="grid-2">
      {allChains.map((c) => (
        <a href={`/chain/${c}`} class={`chain-chip${c === chain ? ' active' : ''}`} data-chain={c}>
          <span class="mono">{c}</span>
          <span class="count">{chainCounts.find((x) => x.chain === c)?.count ?? 0}</span>
        </a>
      ))}
    </div>
    <div id="hidden-panel" style="display:none;margin-top:0.5rem;font-size:0.8rem;">
      <span class="text-muted"><span id="hidden-count">0</span> chains hidden — </span>
      <a href="#" id="show-all-btn" style="color:var(--accent);">show all</a>
    </div>
  </section>

  <div class="section-header">
    <h2>
      {chain === '*' ? (
        <span class="badge" data-chain="*">cross-chain</span>
      ) : (
        <span class="badge" data-chain={chain}>{chain}</span>
      )}
    </h2>
    <span class="text-muted">{labels.length} {labels.length === 1 ? 'label' : 'labels'}</span>
  </div>

  {labels.length === 0 ? (
    <div class="empty-state">
      <p>no labels for chain <strong>{chain}</strong></p>
      <p><a href="/add" class="btn">add label →</a></p>
    </div>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Address</th>
          <th>Label</th>
          <th>Type</th>
          <th>Conf</th>
          <th>Source</th>
          <th>Added</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {labels.map((l) => (
          <tr>
            <td class="address-cell">
              <Address address={l.address} toast />
            </td>
            <td>{l.label}</td>
            <td><a href={`/type/${l.type}`} class="badge" data-type={l.type} style="text-decoration:none;">{l.type}</a></td>
            <td style={l.confidence != null ? `color:var(--conf-${l.confidence < 40 ? 'low' : l.confidence < 70 ? 'mid' : 'high'});font-weight:600` : ''}>{l.confidence != null ? l.confidence : '—'}</td>
            <td class="text-muted">{l.source}</td>
            <td class="text-muted">{l.added_at.slice(0, 10)}</td>
            <td>
              {(() => {
                const url = explorerUrl(l.chain, l.address);
                return url ? (
                  <a href={url} target="_blank" rel="noopener" class="badge" data-chain={l.chain} style="text-decoration:none;font-size:0.7rem;padding:0.1rem 0.4rem;" title="explorer">↗</a>
                ) : null;
              })()}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Base>
