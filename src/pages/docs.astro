---
import Base from '../layouts/Base.astro';

function highlightJson(json: string): string {
  return json
    .replace(/("(?:[^"\\]|\\.)*")\s*:/g, '<span class="hl-key">$1</span>:')
    .replace(/: ("(?:[^"\\]|\\.)*")/g, ': <span class="hl-str">$1</span>')
    .replace(/: (\d+(?:\.\d+)?)/g, ': <span class="hl-num">$1</span>')
    .replace(/: (true|false|null)/g, ': <span class="hl-bool">$1</span>')
    .replace(/([\[\]{}])/g, '<span class="hl-brk">$1</span>')
    .replace(/,/g, '<span class="hl-brk">,</span>');
}

const getResponse = highlightJson(`{
  "labels": [{
    "address": "0x1f98431c8ad98523631ae4a59f267346ea31f984",
    "chain": "ethereum",
    "label": "Uniswap V3",
      "type": "factory",
      "source": "json",
      "confidence": null,
      "added_at": "2026-07-31 15:00:40"
  }],
  "total": 1
}`);

const postBody = highlightJson(`{
  "address": "0xd29c85f15df544ba632c9e25829fd29d767d7978",
  "chain": "robinhood",
  "label": "Across Protocol SpokePool",
  "type": "bridge",
  "confidence": 95
}`);

const putBody = highlightJson(`{
  "label": "Updated Name",
  "type": "dex",
  "confidence": 95
}`);

const successResponse = '{ "success": true }';
---

<Base title="API Docs">
  <h1>api_reference</h1>

  <p class="text-muted" style="margin-bottom:2rem;">
    Base URL: <code style="color:var(--accent3);">http://localhost:4321/api/labels</code>
  </p>

  <h2>auth</h2>
  <p class="text-muted" style="margin-bottom:1rem;">
    Two ways to authenticate: <code>n33gy...</code> tokens (generated via <a href="/admin">/admin</a>, revocable per-token), or the <code>API_KEY</code> value from <code>.env</code> used directly as a Bearer token.
  </p>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code>Authorization: Bearer n33gy&lt;id&gt;_&lt;secret&gt;</code></pre>

  <h2>GET /api/labels</h2>
  <p class="text-muted">List or search labels. Public — no auth required.</p>

  <table style="margin-bottom:1rem;">
    <thead><tr><th>Param</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><span class="doc-param">address</span></td><td><span class="doc-type">string</span></td><td>Lowercase 0x address</td></tr>
      <tr><td><span class="doc-param">chain</span></td><td><span class="doc-type">string</span></td><td>Chain key (ethereum, base, bsc, ...)</td></tr>
      <tr><td><span class="doc-param">type</span></td><td><span class="doc-type">string</span></td><td>Filter by type</td></tr>
      <tr><td><span class="doc-param">label</span></td><td><span class="doc-type">string</span></td><td>Text search on label name</td></tr>
      <tr><td><span class="doc-param">limit</span></td><td><span class="doc-type">int</span></td><td>Max results, default 50</td></tr>
      <tr><td><span class="doc-param">offset</span></td><td><span class="doc-type">int</span></td><td>Pagination offset</td></tr>
      <tr><td><span class="doc-param">bulk</span></td><td><span class="doc-type">bool</span></td><td>Set true to bypass pagination (for exports)</td></tr>
    </tbody>
  </table>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code>GET /api/labels
GET /api/labels?address=0x1f98431c8ad98523631ae4a59f267346ea31f984
GET /api/labels?chain=ethereum
GET /api/labels?label=uniswap
GET /api/labels?type=mixer&amp;bulk=true</code></pre>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code set:html={getResponse}></code></pre>
  <p class="text-muted" style="margin-bottom:2rem;">An unfiltered listing also includes observed facets: a <code>chains</code> array of distinct chain keys and a <code>types</code> array of distinct label types present in the data.</p>

  <h2>POST /api/labels</h2>
  <p class="text-muted">Create a label. Requires auth.</p>

  <table style="margin-bottom:1rem;">
    <thead><tr><th>Field</th><th>Required</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><span class="doc-param">address</span></td><td><span class="doc-req-y">yes</span></td><td>Lowercase 0x address</td></tr>
      <tr><td><span class="doc-param">chain</span></td><td><span class="doc-req-y">yes</span></td><td>Chain key or * for cross-chain</td></tr>
      <tr><td><span class="doc-param">label</span></td><td><span class="doc-req-y">yes</span></td><td>Human-readable name</td></tr>
      <tr><td><span class="doc-param">type</span></td><td><span class="doc-req-n">no</span></td><td>Any string; registered suggestions are available from <code>GET /api/types</code></td></tr>
      <tr><td><span class="doc-param">source</span></td><td><span class="doc-req-n">no</span></td><td>Default: manual</td></tr>
      <tr><td><span class="doc-param">confidence</span></td><td><span class="doc-req-n">no</span></td><td>0–100 confidence score</td></tr>
    </tbody>
  </table>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code>POST /api/labels
Content-Type: application/json
Authorization: Bearer n33gy...</code></pre>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code set:html={postBody}></code></pre>

  <h2>DELETE /api/labels</h2>
  <p class="text-muted">Delete a label. Requires auth.</p>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code>DELETE /api/labels?address=0xabc...&amp;chain=ethereum
<span class="hl-brk">{'{'}</span> <span class="hl-key">"success"</span>: <span class="hl-bool">true</span> <span class="hl-brk">{'}'}</span></code></pre>

  <h2>PUT /api/labels</h2>
  <p class="text-muted">Update a label. Requires auth.</p>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code>PUT /api/labels?address=0x...&amp;chain=ethereum
Content-Type: application/json
Authorization: Bearer n33gy...</code></pre>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code set:html={putBody + '\n' + highlightJson('{ "success": true }')}></code></pre>

  <h2>GET /api/types</h2>
  <p class="text-muted">List registered label type suggestions with their configured colors. Public — no auth required. Browser-local archives do not change this response.</p>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code>GET /api/types</code></pre>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code set:html={highlightJson('{ "types": ["factory", "wallet", "dex", "..."], "colors": { "factory": "#ff79c6", "wallet": "#50fa7b" } }')}></code></pre>

  <h2>GET /api/chains</h2>
  <p class="text-muted">List registered chains with colors and explorer base URLs. Public — no auth required.</p>

  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:0.5rem;"><code>GET /api/chains</code></pre>
  <pre style="background:var(--bg);padding:0.75rem;overflow-x:auto;border:1px solid #3a3a3a;margin-bottom:2rem;"><code set:html={highlightJson('{ "chains": [{ "name": "ethereum", "color": "#627eea", "explorer_base_url": "https://etherscan.io" }] }')}></code></pre>

  <h2>errors</h2>
  <table style="margin-bottom:1rem;">
    <thead><tr><th>Status</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><span class="doc-num">400</span></td><td>Missing required fields</td></tr>
      <tr><td><span class="doc-num">401</span></td><td>Missing or invalid auth</td></tr>
      <tr><td><span class="doc-num">404</span></td><td>Label not found</td></tr>
      <tr><td><span class="doc-num">500</span></td><td>Database error</td></tr>
    </tbody>
  </table>

  <h2>default_chains</h2>
  <p class="text-muted">
    <code>ethereum</code> <code>robinhood</code> <code>base</code> <code>bsc</code> <code>arbitrum</code> <code>optimism</code> <code>polygon</code> <code>avalanche</code> <code>unichain</code> <code>hyperliquid</code> <code>bitcoin</code> <code>solana</code> <code>tron</code> <code>*</code>
  </p>

  <h2>default_types</h2>
  <p class="text-muted">
    <code>factory</code> <code>wallet</code> <code>dex</code> <code>token</code> <code>locker</code> <code>router</code> <code>proxy</code> <code>governance</code> <code>oracle</code> <code>multisig</code> <code>lending</code> <code>staking</code> <code>positions</code> <code>multicall</code> <code>lens</code> <code>hook</code> <code>threatactor</code> <code>cex</code> <code>bridge</code> <code>mixer</code> <code>launcher</code> <code>other</code> <code>unknown</code>
  </p>
</Base>
