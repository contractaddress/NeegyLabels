---
export interface Props {
  address: string;
  link?: boolean;
  toast?: boolean;
}

const { address, link = false, toast = false } = Astro.props;
---

<span
  class:list={['address-mono', { 'copy-addr': toast }]}
  style={toast ? 'cursor:pointer;' : ''}
  title={toast ? 'click to copy' : ''}
  {...(toast ? { 'data-addr': address } : {})}
>
  {link ? (
    <a href={`/?address=${address}`}>
      <span class="addr-prefix">{address.slice(0, 6)}</span>...<span class="addr-suffix">{address.slice(-4)}</span>
    </a>
  ) : (
    <><span class="addr-prefix">{address.slice(0, 6)}</span>...<span class="addr-suffix">{address.slice(-4)}</span></>
  )}
</span>
